# Copy to .env, or run python -m scripts.configure_email for interactive Gmail setup.
# Generate two different values: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
# Default database is backend/instance/gogreen.db. No demo database is used.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Google App Password, never your normal Google password. Enable Google 2-Step Verification first.
# Optional HTTPS delivery alternative: EMAIL_PROVIDER=resend, EMAIL_FROM=verified sender,
# RESEND_API_KEY=your private API key. A verified domain is needed for unrestricted recipients.
FLASK_DEBUG=0
